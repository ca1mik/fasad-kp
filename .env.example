# Mail provider: gmail, outlook, yandex, mailru, smtp
MAIL_PROVIDER=gmail
# Authentication mode: oauth, app_password
MAIL_AUTH_MODE=oauth
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
MAIL_DISPLAY_NAME=

# Required for MAIL_PROVIDER=smtp; may override provider defaults where supported.
SMTP_HOST=
SMTP_PORT=587
# starttls or ssl
SMTP_SECURITY=starttls
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Mail OAuth credentials. Gmail requires the https://mail.google.com/ scope.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
OAUTH_TOKEN_URL=

# Google Sheets: use service account JSON OR the three Google OAuth values.
# Keep inline JSON on one line, for example: {"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SHEET_ID=1soUyxdgnlqU1hMRjtoHAeVii3qcPEMpsH6dXJeQbKqg
GOOGLE_SHEET_NAME=Лиды

DEMO_URL=http://127.0.0.1:8765
DAILY_SEND_LIMIT=15
DRY_RUN=true
ENABLE_FOLLOWUPS=false
TIMEZONE=Europe/Moscow
STATE_PATH=data/outreach.sqlite3
LOG_PATH=logs/outreach.jsonl
HTTP_TIMEOUT=30
